# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Data & runtime ---
data/*.db
data/*.db-*
workspaces/*
!workspaces/.gitkeep
*.log

# --- Packaging artifacts (pyproject) ---
build/
dist/

# --- Generated problem packages ---
# Runtime problem packages are local data; only the directory placeholder is
# tracked. The hand-authored examples now ship inside the package at
# app/seed_problems/ (see pyproject package-data).
problems/*
!problems/.gitkeep

# --- OS / editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- OpenCode local ---
.opencode/local/

# --- Private agent toolkit (kept local, stop shipping to the public repo) ---
.opencode/

# --- Local working files (never part of the public repo) ---
_archive/
agensi.txt
notes.txt
skill_upload.txt
