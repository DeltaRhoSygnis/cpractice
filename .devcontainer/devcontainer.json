{
  "name": "CPractice",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": false
    }
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "CPractice API",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },

  "secrets": {
    "KENARI_API_KEY": {
      "description": "API key for the Kenari OpenCode provider (development tooling only)."
    },
    "GEMINI_API_KEY": {
      "description": "Google AI Studio / Gemini API key used by the CPractice AI provider adapter."
    }
  },

  "remoteEnv": {
    "AI_PROVIDER": "google",
    "KENARI_API_KEY": "${localEnv:KENARI_API_KEY}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "GOOGLE_API_KEY": "${localEnv:GEMINI_API_KEY}"
  }
}
