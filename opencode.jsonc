{
  "$schema": "https://opencode.ai/config.json",

  "//": "Project-scoped OpenCode config for CPractice.",
  "//provider": "kenari key is read from the KENARI_API_KEY env var (Codespaces secret or local shell). Never commit the literal key.",

  "model": "kenari/deepseek-v4-1-flash",

  "provider": {
    "kenari": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kenari",
      "options": {
        "baseURL": "https://api.kenari.ai/v1",
        "apiKey": "{env:KENARI_API_KEY}"
      },
      "models": {
        "deepseek-v4-1-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "pytest*": "allow",
      "python *": "allow",
      "*": "ask"
    },
    "webfetch": "allow"
  }
}
