# CPractice configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# --- AI provider ---
AI_PROVIDER=google

# Model name for the Google Gemini adapter (use a model available to your account).
AI_MODEL=gemini-2.0-flash

# Google AI Studio / Gemini API key.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-key-here

# --- Rate limiting / retry (provider-adapter level) ---
AI_MAX_RETRIES=3
AI_BACKOFF_BASE_SECONDS=2
AI_MAX_CONCURRENT_REQUESTS=2
AI_DAILY_REQUEST_BUDGET=0

# --- Grading engine ---
CC_COMPILER=gcc
CC_STANDARD=c11
RUN_WALL_TIMEOUT_MS=3000
RUN_MEMORY_LIMIT_MB=128
RUN_MAX_OUTPUT_BYTES=65536

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Storage ---
DATABASE_PATH=data/cpractice.db
PROBLEMS_DIR=problems
WORKSPACES_DIR=workspaces

# --- OpenCode (kenari provider) ---
# Injected via Codespaces secret or local shell env. Never commit the real key.
KENARI_API_KEY=
